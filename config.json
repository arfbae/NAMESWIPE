def clean_caption_for_filename(caption: str, rules: dict, original_name: str = "") -> str:
    """Cleans a caption into a descriptive Title-Case file name like:
    "Illustration-Angry-Money-Block-Running-05-07-2025".
    """
    if not caption:
        caption = "untitled"

    words = re.findall(r"[A-Za-z0-9]+", caption)
    tokens = []
    seen = set()
    for word in words:
        token = normalize_token(word)
        if not token or token in DEFAULT_BLOCKLIST:
            continue
        if token in seen:
            continue
        seen.add(token)
        tokens.append(token)

    if len(tokens) < 2:
        fallback_words = re.findall(r"[A-Za-z0-9]+", original_name.replace(".", " "))
        for word in fallback_words:
            token = normalize_token(word)
            if not token or token in DEFAULT_BLOCKLIST or token in seen:
                continue
            seen.add(token)
            tokens.append(token)

    max_words = int(rules.get("max_words", 8))
    tokens = tokens[:max_words]
    if len(tokens) < 2:
        tokens = ["untitled"] + tokens

    title_tokens = [format_title_token(t) for t in tokens if format_title_token(t)]
    base_name = "-".join(title_tokens)

    generic_prefixes = (
        "Gpu-",
        "Computer-",
        "Image-",
        "Photo-",
        "Picture-",
        "Screenshot-",
        "Artwork-",
        "Graphic-",
    )
    if base_name.lower().startswith(generic_prefixes):
        base_name = base_name.split("-", 1)[1] if "-" in base_name else base_name

    date_suffix = extract_date_suffix(original_name)
    if date_suffix:
        base_name = f"{base_name}-{date_suffix}"

    return base_name or "untitled"


def process_images(input_dir: str, output_dir: str, config: dict):
    """Processes images in input_dir, renames them, and moves to output_dir."""
    os.makedirs(output_dir, exist_ok=True)
    os.makedirs(input_dir, exist_ok=True)

    caption_rules = config.get("caption_cleaning_rules", {})
    model_config = config.get("model_config", {})
    model_name = model_config.get("model_name", "microsoft/Florence-2-large")
    max_new_tokens = model_config.get("max_new_tokens", 20)
    num_beams = model_config.get("num_beams", 3)

    device = "cuda" if torch.cuda.is_available() else "cpu"
    print(f"Using device: {device}")

    print(f"Loading model: {model_name}...")
    processor = AutoProcessor.from_pretrained(model_name, trust_remote_code=True)
    model = AutoModelForCausalLM.from_pretrained(model_name, trust_remote_code=True).to(device)
    print("Model loaded.")

    image_extensions = (".jpg", ".jpeg", ".png", ".heic", ".heif", ".webp")
    untitled_counter = 0

    image_files = [f for f in sorted(os.listdir(input_dir)) if f.lower().endswith(image_extensions)]

    if not image_files:
        print(f"No images found in {input_dir}. Please place your images there.")
        return

    for filename in tqdm(image_files, desc="Processing Images"):
        original_filepath = os.path.join(input_dir, filename)
        name, ext = os.path.splitext(filename)

        try:
            image = Image.open(original_filepath).convert("RGB")
            prompt = "An image of"
            inputs = processor(text=prompt, images=image, return_tensors="pt").to(device)
            generated_ids = model.generate(
                input_ids=inputs["input_ids"],
                pixel_values=inputs["pixel_values"],
                max_new_tokens=max_new_tokens,
                num_beams=num_beams,
                do_sample=False,
            )
            generated_text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]
            caption = generated_text.replace(prompt, "").strip()

            if caption:
                new_filename_base = clean_caption_for_filename(caption, caption_rules, original_name=filename)
            else:
                untitled_counter += 1
                new_filename_base = f"untitled_{untitled_counter}"
                tqdm.write(f"Could not generate caption for {filename}, using fallback: {new_filename_base}")

            new_filename = f"{new_filename_base}{ext.lower()}"
            destination_filepath = os.path.join(output_dir, new_filename)

            counter = 1
            while os.path.exists(destination_filepath):
                new_filename = f"{new_filename_base}_{counter}{ext.lower()}"
                destination_filepath = os.path.join(output_dir, new_filename)
                counter += 1

            shutil.move(original_filepath, destination_filepath)

        except Exception as e:
            tqdm.write(f"Error processing {filename}: {e}")
            untitled_counter += 1
            new_filename_base = f"untitled_{untitled_counter}"
            new_filename = f"{new_filename_base}{ext.lower()}"
            destination_filepath = os.path.join(output_dir, new_filename)

            counter = 1
            while os.path.exists(destination_filepath):
                new_filename = f"{new_filename_base}_{counter}{ext.lower()}"
                destination_filepath = os.path.join(output_dir, new_filename)
                counter += 1

            shutil.move(original_filepath, destination_filepath)
            tqdm.write(f"Moved '{filename}' to '{new_filename}' in '{output_dir}' due to error.")

    print("Image processing complete.")


if __name__ == "__main__":
    print("Starting image renaming tool...")
    try:
        config = load_config(CONFIG_FILE)
    except FileNotFoundError:
        print(f"Error: Configuration file '{CONFIG_FILE}' not found. Please ensure it exists.")
        raise SystemExit(1)
    except json.JSONDecodeError:
        print(f"Error: Could not parse '{CONFIG_FILE}'. Please check its format.")
        raise SystemExit(1)

    process_images(INPUT_FOLDER, SB3D_FOLDER, config)
    print("Tool finished.")

