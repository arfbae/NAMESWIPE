import argparse
import json
import logging
import os
import re
import shutil
from pathlib import Path

from PIL import Image
import torch
from tqdm import tqdm
from transformers import BlipForConditionalGeneration, BlipProcessor

# --- Configuration Defaults ---
INPUT_DIR = "./input_images"
ALLOWED_EXTENSIONS = (".jpg", ".jpeg", ".png", ".webp", ".bmp")
MIN_WORDS = 2
MAX_WORDS = 8
DEFAULT_BLOCKLIST = {
    "a",
    "an",
    "and",
    "artwork",
    "by",
    "computer",
    "digital",
    "device",
    "for",
    "gpu",
    "graphic",
    "icon",
    "image",
    "in",
    "logo",
    "of",
    "on",
    "photo",
    "picture",
    "render",
    "screenshot",
    "the",
    "to",
    "wallpaper",
    "with",
}

logging.basicConfig(
    level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s"
)


def extract_date_suffix(filename: str) -> str:
    """Return dd-mm-yyyy from a filename when the date is present."""
    patterns = [
        r"(\d{4})[-_.](\d{1,2})[-_.](\d{1,2})",
        r"(\d{1,2})[-_.](\d{1,2})[-_.](\d{4})",
    ]
    for pattern in patterns:
        match = re.search(pattern, filename)
        if not match:
            continue
        if len(match.group(1)) == 4:
            year, month, day = match.group(1), match.group(2), match.group(3)
        else:
            day, month, year = match.group(1), match.group(2), match.group(3)
        return f"{int(day):02d}-{int(month):02d}-{int(year)}"
    return ""


def normalize_token(token: str) -> str:
    clean = re.sub(r"[^a-z0-9]", "", token.lower())
    if not clean:
        return ""
    if clean in {"3d", "2d"}:
        return clean.upper()
    return clean


def format_title_token(token: str) -> str:
    token = normalize_token(token)
    if not token:
        return ""
    if token.upper() in {"3D", "2D"}:
        return token.upper()
    return token.capitalize()


def build_name_from_caption(caption: str, original_name: str = "", min_words: int = MIN_WORDS, max_words: int = MAX_WORDS) -> str:
    """Convert a raw caption into a clean, descriptive filename fragment.

    Final shape should look like: "Illustration-Angry-Money-Block-Running-24-02-2025"
    and never start with silly prefix words like "gpu", "image", or "photo".
    """
    raw_words = re.findall(r"[A-Za-z0-9]+", caption or "")
    tokens = []
    seen = set()

    for raw_word in raw_words:
        token = normalize_token(raw_word)
        if not token or token in DEFAULT_BLOCKLIST:
            continue
        if token in seen:
            continue
        seen.add(token)
        tokens.append(token)

    if len(tokens) < min_words:
        fallback_words = re.findall(r"[A-Za-z0-9]+", original_name.replace(".", " "))
        for raw_word in fallback_words:
            token = normalize_token(raw_word)
            if not token or token in DEFAULT_BLOCKLIST or token in seen:
                continue
            seen.add(token)
            tokens.append(token)

    tokens = tokens[:max_words]
    if len(tokens) < min_words:
        tokens = ["untitled"] + tokens

    title_tokens = [format_title_token(t) for t in tokens if format_title_token(t)]
    base_name = "-".join(title_tokens)

    # Remove any leading junk if a generic token slipped through.
    generic_prefixes = ("Gpu-", "Computer-", "Image-", "Photo-", "Picture-", "Screenshot-", "Artwork-", "Graphic-")
    if base_name.lower().startswith(generic_prefixes):
        base_name = base_name.split("-", 1)[1] if "-" in base_name else base_name

    date_suffix = extract_date_suffix(original_name)
    if date_suffix:
        base_name = f"{base_name}-{date_suffix}"

    return base_name or "untitled"


def load_model():
    """Loads the BLIP captioning model and processor onto GPU if available."""
    device = "cuda" if torch.cuda.is_available() else "cpu"
    logging.info(f"Loading BLIP image captioning model on device: {device}...")

    processor = BlipProcessor.from_pretrained("Salesforce/blip-image-captioning-base")
    model = BlipForConditionalGeneration.from_pretrained(
        "Salesforce/blip-image-captioning-base"
    ).to(device)

    logging.info("Model loaded successfully.")
    return model, processor, device


def generate_unique_filename(directory: str, base_name: str, ext: str) -> str:
    """Handles potential filename collisions by appending a numeric counter."""
    candidate_name = f"{base_name}{ext}"
    counter = 1
    while os.path.exists(os.path.join(directory, candidate_name)):
        candidate_name = f"{base_name}_{counter}{ext}"
        counter += 1
    return candidate_name


def process_images(input_dir: str):
    """Scans input_dir, generates captions, and renames images to a clean descriptive style."""
    if not os.path.exists(input_dir):
        logging.error(f"Directory '{input_dir}' does not exist.")
        return

    image_files = [
        f
        for f in os.listdir(input_dir)
        if f.lower().endswith(ALLOWED_EXTENSIONS)
    ]

    if not image_files:
        logging.info(f"No valid images found in '{input_dir}'.")
        return

    model, processor, device = load_model()

    logging.info(f"Processing {len(image_files)} images...")

    for filename in tqdm(image_files, desc="Renaming Images"):
        file_path = os.path.join(input_dir, filename)
        ext = os.path.splitext(filename)[1].lower()

        try:
            raw_image = Image.open(file_path).convert("RGB")
            inputs = processor(raw_image, return_tensors="pt").to(device)

            with torch.no_grad():
                output = model.generate(**inputs, max_new_tokens=20)
            raw_caption = processor.decode(output[0], skip_special_tokens=True)

            safe_name = build_name_from_caption(raw_caption, original_name=filename)
            new_filename = generate_unique_filename(input_dir, safe_name, ext)
            new_file_path = os.path.join(input_dir, new_filename)

            os.rename(file_path, new_file_path)
            logging.info(
                f"Renamed: '{filename}' -> '{new_filename}' (Caption: '{raw_caption}')"
            )

        except Exception as e:
            logging.error(f"Failed to process image '{filename}': {e}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Auto-rename images based on content using BLIP."
    )
    parser.add_argument(
        "--input_dir",
        type=str,
        default=INPUT_DIR,
        help="Target directory containing images.",
    )
    args = parser.parse_args()

    process_images(args.input_dir)


"""
Final naming rule:

1. Generate caption.
2. Keep only meaningful words; drop generic junk like GPU, photo, image, screenshot, wallpaper, etc.
3. Keep 2 to 8 words max.
4. Convert to Title Case with hyphens.
5. If the original filename contains a date, append it as DD-MM-YYYY.
6. Example: "goldfish boombox 3d model" + "26-02-2025" => "Goldfish-Boombox-3D-Model-26-02-2025.jpg"
7. Never start with silly prefixes.
"""


